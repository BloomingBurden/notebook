{
  "manifest_version": 3,
  "name": "Smart Notebook — напоминания",
  "version": "1.0.0",
  "description": "Напоминает о повторении заметок при закрытой вкладке Smart Notebook.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "notifications", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Открыть Smart Notebook", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "content_scripts": [{
    "matches": [
      "https://bloomingburden.github.io/notebook/notebook_app_rich_improved.html*",
      "http://localhost/notebook_app_rich_improved.html*",
      "http://127.0.0.1/notebook_app_rich_improved.html*"
    ],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
